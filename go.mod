replace (
	// v0.25.x test deps reference testify paths that break go mod tidy; align with k8s.io/kube-openapi.
	github.com/go-openapi/swag => github.com/go-openapi/swag v0.23.0
	// Match edge-common so rafay-common builds against the legacy pg API.
	github.com/go-pg/pg => github.com/go-pg/pg v6.15.1+incompatible
	// edge-common lists bogus k8s.io/api v1.16.4; override to the same minor as client-go / Karpenter.
	k8s.io/api => k8s.io/api v0.35.1
	k8s.io/apimachinery => k8s.io/apimachinery v0.35.1
	k8s.io/client-go => k8s.io/client-go v0.35.1
)

// Rafay fork of upstream v1.14.1 (branch rafay-release-v1.14.x): raises the NodeClaim registrationTimeout from 15m to 60m,
// which upstream does not expose as a setting (kubernetes-sigs/karpenter#357). Pinned by commit pseudo-version.
replace sigs.k8s.io/karpenter => github.com/RafaySystems/karpenter-rafay v1.14.2-0.20260923143313-91b1217179da
